# Set this to the actual public URL before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: configure if using the Web3Forms API route.
WEB3FORMS_KEY=

# Optional: GA4 measurement id (formats as G-XXXXXXXXXX). Analytics only
# loads after the site visitor explicitly accepts cookies in the consent
# banner. Leave empty to disable analytics entirely. Do not commit a real id.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
