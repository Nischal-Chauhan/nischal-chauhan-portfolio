# Set this to the actual public URL before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web3Forms public access key. The contact form submits directly from the
# browser, so this key travels in client-side code — it is a public key, not
# a server secret. Set it on Vercel (Production, Preview and Development
# environments) or leave empty to break the form with a configuration error.
# Do not commit a real key value.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
